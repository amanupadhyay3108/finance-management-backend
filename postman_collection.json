{
  "info": {
    "name": "Finance Management Backend APIs",
    "description": "API collection for finance backend with auth, records, and dashboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aman\",\n  \"email\": \"aman@gmail.com\",\n  \"password\": \"1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/users/register"
        }
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"aman@gmail.com\",\n  \"password\": \"1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/users/login"
        }
      }
    },
    {
      "name": "Create Record (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 2000,\n  \"type\": \"income\",\n  \"category\": \"salary\",\n  \"date\": \"2026-04-02T00:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/records"
        }
      }
    },
    {
      "name": "Get Records",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
        ],
        "url": {
          "raw": "http://localhost:5000/records"
        }
      }
    },
    {
      "name": "Dashboard Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
        ],
        "url": {
          "raw": "http://localhost:5000/dashboard"
        }
      }
    }
  ]
}